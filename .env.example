# Firebase Spark project. Dashboard visitors never sign in.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=homeintegrations-43740
# Needed only for the owner to link Google Home using Firebase Email/Password.
NEXT_PUBLIC_FIREBASE_API_KEY=

# Private server secrets. Never prefix these with NEXT_PUBLIC_.
# Supply the service-account JSON as one line in the hosting environment.
FIREBASE_SERVICE_ACCOUNT_JSON=
TANK_OAUTH_CLIENT_ID=terrace-tank-google-home
TANK_OAUTH_CLIENT_SECRET=
CRON_SECRET=
# Owner-only calibration writes. At least 32 random characters; separate from the upload key.
TANK_ADMIN_KEY=
